# Django: valores seguros solo para desarrollo local.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-development-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_DEFAULT_FROM_EMAIL=Portal de condominios <no-reply@localhost>

# SMTP. En desarrollo el correo se imprime en los logs del contenedor web.
# Para probar SMTP real en desarrollo, define DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend en .env.
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=false
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_TIMEOUT=10

# PostgreSQL
# Para Neon/Vercel usa DATABASE_URL (URL pooled de la aplicación, con sslmode=require).
# La migración/backup debe usar la URL directa DATABASE_URL_DIRECT, nunca el pooler.
# Define ambas solo en el gestor de secretos; no incluyas credenciales en archivos versionados.
# DATABASE_URL=
# DATABASE_URL_DIRECT=
# Solo para despliegues serverless (p. ej. Vercel); Docker local usa el filesystem.
# OBJECT_STORAGE_BACKEND=s3
# AWS_STORAGE_BUCKET_NAME=condominio-comprobantes
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=us-east-2
POSTGRES_DB=condominio
POSTGRES_USER=condominio
POSTGRES_PASSWORD=condominio_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_EXPOSE_PORT=5432
POSTGRES_CONN_MAX_AGE=0
POSTGRES_CONNECT_TIMEOUT=5

# Puerto publicado por el servidor de desarrollo.
DJANGO_EXPOSE_PORT=8000
