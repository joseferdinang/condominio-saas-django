# Copy to .env.production. No usable credentials are included.
APP_DOMAIN=condominio.example.com
ACME_EMAIL=administrador@example.com
DJANGO_ALLOWED_HOSTS=condominio.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://condominio.example.com
DJANGO_DEFAULT_FROM_EMAIL=Condominio <no-reply@example.com>
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
POSTGRES_DB=condominio
POSTGRES_USER=condominio
POSTGRES_CONN_MAX_AGE=60
GUNICORN_WORKERS=2
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_TIMEOUT=10
# Paths are mounted as Compose secrets, never copied into the image.
# Generate the files with: python3 ops/production.py init-secrets
